// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String    @id @default(uuid())
  name     String?
  email    String    @unique
  password String?
  role     String    @default("ADMIN")
  regionId String?
  region   Region?   @relation(fields: [regionId], references: [id])
  sessions Session[]
  accounts Account[]

  @@index([email])
  @@index([role])
  @@index([regionId])
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Account {
  id                String @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  regions   Region[]
  createdAt DateTime @default(now())

  @@index([name])
}

model Region {
  id                  String   @id @default(uuid())
  name                String
  branchId            String
  branch              Branch   @relation(fields: [branchId], references: [id])
  families            Family[]
  coordinators        User[]
  coordinatorMemberId String?  @unique
  coordinator         Member?  @relation("RegionCoordinator", fields: [coordinatorMemberId], references: [id])
  createdAt           DateTime @default(now())

  @@index([branchId])
  @@index([name])
}

model Family {
  id             String   @id @default(uuid())
  familyName     String
  address        String?
  provinsi       String?
  kotaKabupaten  String?
  kecamatan      String?
  kelurahan      String?
  regionId       String
  region         Region   @relation(fields: [regionId], references: [id])
  members        Member[]
  createdAt      DateTime @default(now())

  @@index([regionId])
  @@index([familyName])
  @@index([kotaKabupaten])
  @@index([kecamatan])
}

model Member {
  id                 String        @id @default(uuid())
  firstName          String
  lastName           String?
  birthCity          String
  gender             Gender
  birthDate          DateTime
  phone              String
  email              String?
  role               MemberRole
  childNumber        Int?
  sameAddressAsFamily Boolean      @default(true)
  memberAddress      String?
  memberProvinsi     String?
  memberKotaKabupaten String?
  memberKecamatan    String?
  memberKelurahan    String?
  isActive           Boolean       @default(true)
  isDeceased         Boolean       @default(false)
  deathDate          DateTime?
  isPresbyter        Boolean       @default(false)
  bloodType          BloodType?
  pelkat             MemberPelkat?
  // ── Baptis ──
  statusBaptis       BaptisStatus?  @default(BELUM)
  lokasiBaptis       String?
  tanggalBaptis      DateTime?
  // ── Sidi ──
  statusSidi         SidiStatus?    @default(BELUM)
  lokasiSidi         String?
  tanggalSidi        DateTime?
  // ── Status Keaktifan ──
  tanggalPindah      DateTime?
  // ── Perkawinan ──
  statusPerkawinan   PerkawinanStatus? @default(BELUM_MENIKAH)
  lokasiPemberkatanGereja  String?
  tanggalPemberkatanGereja DateTime?
  lokasiPerkawinanSipil    String?
  tanggalPerkawinanSipil   DateTime?
  // ── Jabatan, pendidikan, dsb. ──
  jabatan            Jabatan?
  gerejaAsal         String?
  pendidikanTerakhir String?
  pekerjaan          String?
  tahunDaftar        String?
  pengalamanGereja    String?
  pengalamanOrganisasi String?
  keteranganLain      String?
  familyId           String
  family             Family        @relation(fields: [familyId], references: [id])
  coordinatedRegion  Region?       @relation("RegionCoordinator")

  createdAt DateTime @default(now())

  @@index([familyId])
  @@index([firstName])
  @@index([lastName])
  @@index([isActive])
  @@index([isPresbyter])
  @@index([gender])
  @@index([pelkat])
  @@index([birthDate])
}

enum BaptisStatus {
  SUDAH
  BELUM
}

enum SidiStatus {
  SUDAH
  BELUM
}

enum PerkawinanStatus {
  BELUM_MENIKAH
  JANDA
  DUDA
  MENIKAH
}

enum Jabatan {
  DIAKEN
  PENATUA
  PENGURUS_PELKAT
  PENGURUS_KOMISI
}

enum BloodType {
  A
  B
  AB
  O
}

enum MemberRole {
  FAMILY_HEAD
  WIFE
  CHILD
  OTHER
  ORANG_TUA
  CUCU
  KAKAK_ADIK_KANDUNG
  FAMILI_LAIN
}

model Attendance {
  id          String   @id @default(uuid())
  serviceDate DateTime
  serviceType String

  maleCount   Int
  femaleCount Int
  totalCount  Int

  createdAt DateTime @default(now())

  @@unique([serviceDate, serviceType])
  @@index([serviceDate])
  @@index([serviceType])
}

enum Gender {
  MALE
  FEMALE
}

enum MemberPelkat {
  PELAYANAN_ANAK
  PERSEKUTUAN_TARUNA
  GERAKAN_PEMUDA
  PERSEKUTUAN_KAUM_BAPAK
  PERSEKUTUAN_KAUM_PEREMPUAN
  PERSEKUTUAN_KAUM_LANJUT_USIA
}
